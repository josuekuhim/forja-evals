+    )
+    decoder_fns = _triton_jit_with_unique_names(decoder_fns)
+    tmpdir = Path(tempfile.mkdtemp(prefix="pl_triton_decoder_"))
+    out = tmpdir / "librdma_triton_decoder.so"
+    try:
+        return _build_so(
+            _persistent_decoder_kernel,
+            signature={
+                "ring_u64_ptr": "*u64",
+                "handoff_u64_ptr": "*u64",
+                "stop_u32_ptr": "*u32",
+                "ring_slots": "u32",
+                "total": "u64",
+            },
+            constexpr={"decoder_fns": tuple(decoder_fns)},
+            grid=grid,
+            platform=platform.strip(),
+            out=str(out.resolve()),
+            num_warps=num_warps,
+            num_stages=num_stages,
+            compiler=compiler,
+            cflags=tuple(cflags),
