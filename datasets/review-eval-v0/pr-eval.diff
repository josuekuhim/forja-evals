+        if "asan" in args.build_variant:
+            prefix = f"{prefix}-asan-{modified_rocm_version}"
+        else:
+            prefix = f"{prefix}-{modified_rocm_version}"
+
+    # Validate package type
+    pkg_type = (args.pkg_type or "").lower()
+    valid_types = {"deb", "rpm"}
+    if pkg_type not in valid_types:
+        raise ValueError(
