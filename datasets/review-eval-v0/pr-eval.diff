+_field_type_mapping: Dict[Union[Type, str], Type] = {
+    list: ArrayTypeClass,
+    bool: BooleanTypeClass,
+    type(None): NullTypeClass,
+    int: NumberTypeClass,
+    float: NumberTypeClass,
+    str: StringTypeClass,
+    dict: RecordTypeClass,
+    "mixed": UnionTypeClass,
+}
+
+logger = logging.getLogger(__name__)
